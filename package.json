{
  "name": "@maltazar/freelens-envoy-gateway-extension",
  "version": "0.1.0",
  "description": "Envoy Gateway policies, proxies and attachment visibility for Freelens 2",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=24", "freelens": "^2.0.0" },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-bundle.mjs",
    "prepack": "npm run check",
    "pack:local": "npm run check && npm pack --ignore-scripts --pack-destination artifacts && node scripts/checksum.mjs"
  },
  "devDependencies": {
    "@freelensapp/extensions": "2.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "keywords": ["freelens", "extension", "envoy", "gateway-api", "kubernetes"]
}