{
  "name": "@maltazar/freelens-envoy-gateway-extension",
  "version": "0.1.2",
  "description": "Envoy Gateway policies, proxies and attachment visibility for Freelens 2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maltazar/freelens-envoy-extension.git"
  },
  "homepage": "https://github.com/Maltazar/freelens-envoy-extension#readme",
  "bugs": { "url": "https://github.com/Maltazar/freelens-envoy-extension/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=24", "freelens": "^2.0.0" },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test test/release.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-bundle.mjs && npm run test:release",
    "prepack": "npm run check",
    "pack:local": "npm run check && node scripts/release.mjs"
  },
  "devDependencies": {
    "@freelensapp/extensions": "2.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "keywords": ["freelens", "extension", "envoy", "gateway-api", "kubernetes"]
}